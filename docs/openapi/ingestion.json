{
  "openapi": "3.1.0",
  "info": {
    "title": "EventFlow Ingestion API",
    "version": "0.1.0",
    "description": "JWT bearer authentication required. Tenant comes from tenant_id; producer ownership comes from sub. Cross-tenant resources return 404. See docs/security/authentication.md."
  },
  "servers": [
    {
      "url": "http://localhost:8080"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/api/v1/events": {
      "post": {
        "summary": "Accept atomically; same ID and content returns duplicate acceptance, different content returns 409.",
        "responses": {
          "202": {
            "description": "Durably accepted",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "eventId": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "status": {
                      "const": "ACCEPTED"
                    },
                    "duplicate": {
                      "type": "boolean"
                    },
                    "acceptedAt": {
                      "type": "string",
                      "format": "date-time"
                    }
                  }
                }
              }
            }
          },
          "default": {
            "description": "Error; malformed input 400, missing entity 404, conflict 409, admission limit 429, infrastructure failure 5xx.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid JWT (signature, issuer, audience, lifetime, tenant or subject)."
          },
          "403": {
            "description": "Valid token lacks the role required for this operation."
          },
          "404": {
            "description": "Entity is absent, outside this tenant, or owned by another producer."
          },
          "429": {
            "description": "Atomic tenant or producer admission quota exhausted; Retry-After header."
          },
          "503": {
            "description": "Admission limiter unavailable in fail-closed mode; retry later."
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "eventId",
                  "eventType",
                  "source",
                  "schemaVersion",
                  "occurredAt",
                  "payload"
                ],
                "properties": {
                  "eventId": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "eventType": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 120
                  },
                  "source": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 120
                  },
                  "schemaVersion": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 10000
                  },
                  "occurredAt": {
                    "type": "string",
                    "format": "date-time",
                    "description": "Must not be in the future."
                  },
                  "payload": {},
                  "metadata": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "string",
                      "maxLength": 500
                    }
                  }
                }
              }
            }
          }
        },
        "description": "PRODUCER or ADMIN. UUIDs are globally unique. Idempotent acceptance is scoped to the original tenant and producer; a reused foreign UUID returns 404. tenantId/producerId request properties do not set ownership."
      }
    },
    "/api/v1/events/{eventId}": {
      "get": {
        "summary": "Inspect ingestion-owned acceptance/publication status",
        "responses": {
          "200": {
            "description": "Success"
          },
          "default": {
            "description": "Error; malformed input 400, missing entity 404, conflict 409, admission limit 429, infrastructure failure 5xx.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid JWT (signature, issuer, audience, lifetime, tenant or subject)."
          },
          "403": {
            "description": "Valid token lacks the role required for this operation."
          },
          "404": {
            "description": "Entity is absent, outside this tenant, or owned by another producer."
          }
        },
        "parameters": [
          {
            "name": "eventId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "description": "PRODUCER may read its own events; VIEWER, DLQ_OPERATOR and ADMIN may read events in their tenant."
      }
    }
  },
  "components": {
    "schemas": {
      "Problem": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "detail": {
            "type": "string"
          },
          "instance": {
            "type": "string"
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}
