{
  "openapi": "3.1.0",
  "info": {
    "title": "EventFlow Processing API",
    "version": "0.1.0",
    "description": "JWT bearer authentication required. Tenant comes from tenant_id; producer ownership comes from sub. Cross-tenant resources return 404. See docs/security/authentication.md."
  },
  "servers": [
    {
      "url": "http://localhost:8081"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/api/v1/pipelines": {
      "post": {
        "summary": "Create a structurally valid draft",
        "responses": {
          "201": {
            "description": "Draft created; Location points to the summary",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "name": {
                      "type": "string"
                    },
                    "version": {
                      "type": "integer"
                    },
                    "eventType": {
                      "type": "string"
                    },
                    "active": {
                      "type": "boolean"
                    },
                    "state": {
                      "enum": [
                        "DRAFT",
                        "VALIDATED",
                        "ACTIVE",
                        "SUPERSEDED",
                        "DISABLED"
                      ]
                    },
                    "revision": {
                      "type": "integer"
                    },
                    "createdAt": {
                      "type": "string",
                      "format": "date-time"
                    }
                  }
                }
              }
            }
          },
          "default": {
            "description": "Error; malformed input 400, missing entity 404, conflict 409, admission limit 429, infrastructure failure 5xx.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid JWT (signature, issuer, audience, lifetime, tenant or subject)."
          },
          "403": {
            "description": "Valid token lacks the role required for this operation."
          },
          "404": {
            "description": "Entity is absent, outside this tenant, or owned by another producer."
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$schema": "https://json-schema.org/draft/2020-12/schema",
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "name",
                  "version",
                  "eventType",
                  "steps"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9._-]{1,119}$"
                  },
                  "version": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 2147483647
                  },
                  "eventType": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9._-]{1,119}$"
                  },
                  "steps": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 32,
                    "items": {
                      "oneOf": [
                        {
                          "type": "object",
                          "additionalProperties": false,
                          "required": [
                            "type",
                            "schema"
                          ],
                          "properties": {
                            "type": {
                              "const": "validate"
                            },
                            "schema": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 120
                            }
                          }
                        },
                        {
                          "type": "object",
                          "additionalProperties": false,
                          "required": [
                            "type",
                            "source"
                          ],
                          "properties": {
                            "type": {
                              "const": "enrich"
                            },
                            "source": {
                              "type": "string",
                              "pattern": "^[a-z][a-z0-9._-]{1,119}$"
                            }
                          }
                        },
                        {
                          "type": "object",
                          "additionalProperties": false,
                          "required": [
                            "type",
                            "target",
                            "destination"
                          ],
                          "properties": {
                            "type": {
                              "const": "route"
                            },
                            "target": {
                              "enum": [
                                "POSTGRES",
                                "CLICKHOUSE",
                                "EXTERNAL_HTTP"
                              ]
                            },
                            "destination": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 255
                            },
                            "options": {
                              "type": "object",
                              "maxProperties": 0
                            }
                          }
                        }
                      ]
                    }
                  }
                }
              }
            }
          }
        },
        "description": "PIPELINE_EDITOR or ADMIN for mutations; VIEWER may read. All configuration is tenant scoped."
      }
    },
